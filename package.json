{
  "name": "aios",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first AI Operating System with multi-agent governance",
  "type": "module",
  "workspaces": [
    "shared",
    "packages/ai-engine",
    "packages/agents",
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev": "concurrently -n BE,FE -c blue,green \"npm run dev -w packages/backend\" \"npm run dev -w packages/frontend\"",
    "dev:backend": "npm run dev -w packages/backend",
    "dev:frontend": "npm run dev -w packages/frontend",
    "build": "npm run build -w packages/frontend",
    "start": "NODE_ENV=production node packages/backend/server.js",
    "setup": "node scripts/setup.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed.js --demo",
    "test": "vitest run",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.15.0",
    "prettier": "^3.4.2",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "GhostRiderGaming",
  "license": "MIT"
}
