# AIOS Environment Configuration
# Copy this file to .env and fill in values

# Server
PORT=3001
NODE_ENV=development

# Authentication
JWT_SECRET=change-this-to-a-random-secret-in-production

# Database
DB_PATH=./data/aios.db

# AI Inference — Gemini (PRIMARY)
# Get your free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# AI Inference — Ollama (LOCAL, optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Frontend
VITE_API_URL=http://localhost:3001

# Demo Mode (set to true for deterministic pre-scripted responses)
# When false + GEMINI_API_KEY is set → uses live Gemini inference
DEMO_MODE=false

# File Upload
UPLOAD_DIR=./data/uploads
